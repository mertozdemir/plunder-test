# Static PWA. Railway sets PORT and terminates TLS in front of us.
:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	file_server
	# The service worker and manifest must never be cached, or updates stall.
	@nocache path /sw.js /registerSW.js /manifest.webmanifest /index.html /
	header @nocache Cache-Control "no-cache"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
