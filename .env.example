# apps/web (Vite) — copy to apps/web/.env.local
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# LiveKit token service (Railway) base URL
VITE_TOKEN_SERVICE_URL=http://localhost:8787
# LiveKit server WebSocket URL (your VPS)
VITE_LIVEKIT_URL=wss://livekit.example.com
# Phase 0 spike: end-to-end encrypt voice/screen (SFrame via insertable streams)
VITE_FEATURE_E2EE=false

# services/livekit-token — set on Railway
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://livekit.example.com
ALLOWED_ORIGINS=http://localhost:5173
PORT=8787
